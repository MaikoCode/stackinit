{
  "name": "stackinit",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "stackinit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node ./scripts/copy-assets.mjs",
    "pack:local": "npm pack",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "fs-extra": "^11.3.3",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stackinit/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
